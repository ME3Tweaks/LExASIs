// WARNING: DO NOT EDIT THIS FILE IN VISUAL STUDIO'S RESOURCE EDITOR!
// Editing this file in the Visual Studio resource editor will break the #include directives
// and the version macros. Edit this file manually in a text editor only.

#include <windows.h>
#include "SharedVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APP_VERSION_RC
 PRODUCTVERSION APP_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ME3Tweaks"
            VALUE "FileDescription", APP_DESCRIPTION
            VALUE "FileVersion", VERSION_STRING
            VALUE "InternalName", APP_NAME
            VALUE "LegalCopyright", "Copyright (C) " CURRENT_YEAR "ME3Tweaks"
            VALUE "OriginalFilename", GAME_PREFIX_RC APP_NAME ".asi"
            VALUE "ProductName", APP_NAME
            VALUE "ProductVersion", VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
